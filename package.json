{
  "name": "unofficial-free-llm-api",
  "version": "0.8.1",
  "description": "A local OpenAI-compatible API and web playground for a DeepSeek chat account you already have, plus Qoder through its official CLI. Unofficial.",
  "license": "MIT",
  "author": "teminali",
  "homepage": "https://github.com/teminali/unofficial-free-llm-api#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/teminali/unofficial-free-llm-api.git"
  },
  "bugs": {
    "url": "https://github.com/teminali/unofficial-free-llm-api/issues"
  },
  "funding": {
    "type": "custom",
    "url": "https://github.com/teminali/unofficial-free-llm-api/blob/HEAD/DONATE.md"
  },
  "keywords": [
    "llm",
    "openai-compatible",
    "api",
    "playground",
    "deepseek",
    "unofficial",
    "proxy",
    "chat",
    "qoder"
  ],
  "bin": {
    "unofficial-free-llm-api": "bin/unofficial-free-llm-api.js",
    "ula": "bin/unofficial-free-llm-api.js"
  },
  "main": "src/server.js",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "bin",
    "src",
    "web",
    "docs/*.md",
    "examples",
    "DONATE.md",
    "DISCLAIMER.md",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "start": "node bin/unofficial-free-llm-api.js",
    "demo": "node bin/unofficial-free-llm-api.js --demo --providers demo",
    "test": "node --test --test-timeout=300000 \"test/**/*.test.js\""
  },
  "devDependencies": {
    "jsdom": "^26.1.0"
  }
}
